# Copy this file to .env.local and fill the values before the first real pair run.
# snowl-mobile auto-loads .env and .env.local from the current working directory,
# so you do not need to run `set -a; source .env.local; set +a` before the CLI.

# Local upstream repo paths
OPEN_AUTOGLM_HOME=references/agents/Open-AutoGLM
MOBILE_SAFETY_HOME=references/benchmarks/mobilesafetybench
ANDROID_WORLD_HOME=references/benchmarks/android_world
ANDROID_WORLD_PYTHON=
ANDROID_WORLD_ADB_PATH=adb

# Open-AutoGLM model endpoint
PHONE_AGENT_BASE_URL=
PHONE_AGENT_API_KEY=
PHONE_AGENT_MODEL=gpt-4o

# Mobile-Agent-E wrap-first adapter
# MOBILE_AGENT_E_HOME is the only path you normally need to add.
# If the fields below stay empty, the wrapper will reuse PHONE_AGENT_BASE_URL /
# PHONE_AGENT_API_KEY / PHONE_AGENT_MODEL for the first smoke run.
MOBILE_AGENT_E_HOME=references/agents/MobileAgent/Mobile-Agent-E
MOBILE_AGENT_E_BASE_URL=
MOBILE_AGENT_E_API_KEY=
MOBILE_AGENT_E_REASONING_MODEL=
# Optional caption overrides. Leave these empty to reuse the reasoning endpoint
# when you are not in lightweight perception mode.
MOBILE_AGENT_E_CAPTION_API_KEY=
MOBILE_AGENT_E_CAPTION_BASE_URL=
MOBILE_AGENT_E_CAPTION_MODEL=qwen-vl-plus
MOBILE_AGENT_E_CAPTION_CALL_METHOD=api
MOBILE_AGENT_E_ADB_PATH=adb
MOBILE_AGENT_E_PERCEPTION_DEVICE=
MOBILE_AGENT_E_STEP_SLEEP_SEC=
# For the first real smoke run, keep this as 1 to use the platform's lightweight
# perception shim instead of the full upstream OCR/grounding dependency chain.
MOBILE_AGENT_E_LIGHTWEIGHT_PERCEPTION=1
# You do not need to copy PHONE_AGENT_* into MOBILE_AGENT_E_* unless you want
# Mobile-Agent-E to use a different endpoint or model than Open-AutoGLM.

# Mobile-Agent-v3.5 wrap-first adapter
# This path now runs through the platform MobileSafetyBench pair bridge with
# configs/runs/mobile_agent_v3_5_mobilesafetybench.yml.
# A dedicated worker env is still pending.
MOBILE_AGENT_V3_5_HOME=references/agents/MobileAgent/Mobile-Agent-v3.5
MOBILE_AGENT_V3_5_BASE_URL=
MOBILE_AGENT_V3_5_API_KEY=
MOBILE_AGENT_V3_5_MODEL=
MOBILE_AGENT_V3_5_ADB_PATH=adb
MOBILE_AGENT_V3_5_APP_RESOLVER_API_KEY=
MOBILE_AGENT_V3_5_APP_RESOLVER_BASE_URL=
MOBILE_AGENT_V3_5_APP_RESOLVER_MODEL=qwen-plus

# Android / Appium tooling
ANDROID_SDK_ROOT=
ANDROID_HOME=
APPIUM_BIN=appium

# Optional notes:
# - The current first real pair path is in_process, so the environment that runs
#   `snowl-mobile run` must also be able to import `phone_agent` and `mobile_safety`.
# - The recommended checked-in run config is now
#   configs/runs/autoglm_mobilesafetybench.yml
# - PHONE_AGENT_MODEL is used by the default minimal config, so switching models
#   usually only requires editing .env.local instead of editing YAML.
# - The checked-in Mobile-Agent-E run config is
#   configs/runs/mobile_agent_e_mobilesafetybench.yml
# - For the first real Mobile-Agent-E smoke run, keep
#   `MOBILE_AGENT_E_LIGHTWEIGHT_PERCEPTION=1` and override `SNOWL_TASK_SELECTOR`
#   to a single task instead of editing the YAML.
# - The checked-in Mobile-Agent-v3.5 run config is
#   configs/runs/mobile_agent_v3_5_mobilesafetybench.yml
# - Mobile-Agent-v3.5 now has a dedicated MobileSafetyBench pair bridge for
#   reset/seed/bootstrap/final evaluation, but it still reuses the host Python
#   environment and the upstream `mobile_use` dependencies in this phase.
# - AndroidWorld now supports benchmark-side `benchmark-setup` / `benchmark-run`
#   through configs/runs/androidworld_benchmark.yml, and the first minimal
#   Open-AutoGLM real-pair config is configs/runs/autoglm_androidworld.yml.
# - `ANDROID_WORLD_PYTHON` is the preferred place to point to a dedicated
#   AndroidWorld virtualenv for both the benchmark-side path and the real pair.
