project:
  name: ${adapter_id}-integration-demo
  run_name: ${adapter_id}-smoke
  description: >
    TODO: fill this config after wiring the real benchmark adapter and a compatible local agent.

models:
  - model_id: dummy_text_model
    provider: openai
    api_style: openai_chat
    modalities: [text]
    supports_image_input: false
    supports_tool_calling: false
    supports_json_mode: false

agents:
  - agent_id: dummy_text_agent
    model_ref: dummy_text_model
    integration_mode: native
    supported_modalities: [text]
    required_modalities: [text]
    supported_model_protocols: [openai_chat]

benchmarks:
  - benchmark_id: ${adapter_id}
    display_name: ${display_name}
    integration_mode: ${integration_mode_lower}
    task_source:
      kind: reference_repo
      path: ${repo_path}
      selector: ${task_discovery_entry}
      manifest: ${task_discovery_entry}
    metric_schema:
      primary_metric: ${primary_platform_metric}
      native_metrics: [${primary_native_metric}]
    scorer_ref: ${score_capture_entry}
    reset_policy: ${reset_entry}
    reset_requirements:
      requires_task_seed: false
    device_backend: adb_appium
    required_env: []

matrix:
  expand: agent_x_benchmark
  seeds: [seed-0001]

runtime:
  batch_size: 1
  timeout_sec: 900
  max_steps: 30
  env_isolation: per_worker_venv

devices:
  default_profile: api34_base

retries:
  max_trial_retries: 1

artifacts:
  level: standard
